# Required in production — comma-separated list of allowed frontend origins
CLIENT_ORIGINS=https://your-app.vercel.app

# Server port (default 3001)
PORT=3001

# Node environment
NODE_ENV=production

# Supabase (for v2 — when swapping in-memory leaderboard for Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
