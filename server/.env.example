# Required in production — comma-separated list of allowed frontend origins.
# The server refuses to start in production when this is missing.
CLIENT_ORIGINS=https://your-app.vercel.app

# Server port (default 3001)
PORT=3001

# Node environment
NODE_ENV=production

# Supabase — required. The server exits on startup if either value is missing.
# Use the service role key here only. Never put it in the client, in git, or in a public log.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
