# Supabase project URL and anon (public) key — required to start the client.
# The anon key is meant to be public. Row Level Security is what protects your data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Socket.IO server. Defaults to http://localhost:3001 when unset.
VITE_SERVER_URL=http://localhost:3001
